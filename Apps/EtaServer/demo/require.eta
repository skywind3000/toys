<%
// require.eta - module loading demo: require() is anchored to this
// file's directory (module.createRequire), so relative paths and
// node_modules lookup behave like a .js file living right here.
const path = require('node:path')
%><!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>require() demo</title></head>
<body>
  <h1>require() demo</h1>
  <p>SCRIPT_DIRNAME = <code><%= _SERVER.SCRIPT_DIRNAME %></code></p>
  <p>path.join check = <code><%= path.join(_SERVER.SCRIPT_DIRNAME, 'x.txt') %></code></p>
  <p>Try: <code>npm i dayjs</code> in this directory, then
     <code>const dayjs = require('dayjs')</code> in a template.</p>
  <p><a href="index.eta">back home</a></p>
</body>
</html>
