<%
// fetchdemo.eta - 在模板里请求外部 URL（顶层 await + 内置 fetch）
//
// renderAsync 把模板编译为 async function 体，所以 <% %> 内可以顶层 await；
// 等待网络期间事件循环照常服务其它请求，不会阻塞单线程。
let repos = null
let error = null
try {
  const ctrl = new AbortController()
  const timer = setTimeout(() => ctrl.abort(), 8000)   // 8 秒超时保护
  const resp = await fetch('https://api.github.com/users/nodejs/repos?per_page=5',
    { signal: ctrl.signal })
  clearTimeout(timer)
  if (!resp.ok) throw new Error('HTTP ' + resp.status)
  repos = await resp.json()
} catch (e) {
  error = String(e && e.message || e)
}
%><!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>fetch demo</title></head>
<body>
  <h1>fetch in .eta (top-level await)</h1>
  <% if (error) { %>
    <p style="color:#a00">fetch failed: <%= error %>
       （本机网络不通时此页演示错误分支）</p>
  <% } else { %>
    <ul>
    <% for (const r of repos) { %>
      <li><a href="<%= r.html_url %>"><%= r.name %></a>
          - stars: <%= r.stargazers_count %></li>
    <% } %>
    </ul>
  <% } %>
  <p><a href="index.eta">back home</a></p>
</body>
</html>
