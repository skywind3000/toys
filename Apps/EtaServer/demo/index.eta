<%
// index.eta - EtaServer demo home page
// bare superglobal access thanks to useWith: _GET, _SESSION, _SERVER ...
const name = _GET.name || 'world'
_SESSION.count = (_SESSION.count || 0) + 1
%><!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>EtaServer Demo</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1>EtaServer Demo</h1>
  <p>Hello, <b><%= name %></b>!</p>
  <p>Visits in this session: <b><%= _SESSION.count %></b>
     (signed cookie session, sliding 30 min)</p>
  <form method="get" action="index.eta">
    <input type="text" name="name" placeholder="your name"
           value="<%= name %>">
    <button type="submit">Say hello</button>
  </form>
  <ul>
    <li><a href="hello.eta/linwei/42">PATH_INFO demo</a>
        (try appending your own segments)</li>
    <li><a href="api.eta">JSON API demo</a>
        (also accepts POST: form or JSON body)</li>
    <li><a href="require.eta">require() demo</a></li>
  </ul>
  <hr>
  <p>
    method: <%= _SERVER.REQUEST_METHOD %> &nbsp;
    script: <%= _SERVER.SCRIPT_NAME %> &nbsp;
    time: <%= new Date().toLocaleString() %>
  </p>
</body>
</html>
